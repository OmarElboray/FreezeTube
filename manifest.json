{
  "manifest_version": 3,
  "name": "FreezeTube – Stop YouTube Algorithm & Homepage Feed",
  "version": "4.0.1",
  "description": "Take back your time. FreezeTube locks your YouTube homepage so the algorithm can never pull you back in.",
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["js/content_bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["js/seed.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}